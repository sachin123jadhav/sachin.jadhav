# Contact form delivery — copy to .env.local and fill in what you want.
#
# The form works with nothing set here: the visitor's browser sends the message
# through the FormSubmit relay, which emails an activation link to the address
# on the first submission. Click that link once and every message after it is
# delivered. (FormSubmit blocks requests from servers like Vercel's, so this
# relay always runs in the browser.)
#
# Transports are tried in this order, first one configured wins:
#   1. RESEND_API_KEY         (recommended)
#   2. WEB3FORMS_ACCESS_KEY
#   3. FormSubmit relay from the browser (default, no account needed)

# --- Where messages go (Resend and Web3Forms) ---
# The browser FormSubmit relay always sends to the address hard-coded as
# CONTACT_EMAIL in src/app/contact/contact-me.jsx; change it there too.
CONTACT_TO_EMAIL=sachin123jadhav@gmail.com

# --- 1. Resend (https://resend.com/api-keys) ---
# Best option: sends from your own domain and sets reply-to to the visitor.
# Until you verify a domain you can leave CONTACT_FROM_EMAIL unset and Resend
# will use its shared onboarding sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- 2. Web3Forms (https://web3forms.com) ---
# Free, no domain needed. Messages are delivered to the address you signed up with.
WEB3FORMS_ACCESS_KEY=

# --- Site address ---
# Used for canonical links, the share image, sitemap.xml and robots.txt.
# Include the protocol, e.g. https://example.com. Defaults to
# https://sachin-jadhav.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=
